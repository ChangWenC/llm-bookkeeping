        "candidate_id",
        "chunk_id",
        "disposition",
        "content",
        "subject",
        "occurred_at",
        "journal_date",
        "kind",
        "analytics_projection",
        "event_refs",
        "target_refs",
        "scope",
        "attribution"
      ],
      "not": {
