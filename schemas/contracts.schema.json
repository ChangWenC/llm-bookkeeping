{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-bookkeeping.local/contracts-v1.schema.json",
  "title": "Bookkeeping version 1 records",
  "description": "Runtime semantic validation additionally checks IDs, dates, explicit zero facts, refs, limits and bundle membership.",
  "anyOf": [
    {
      "$ref": "#/$defs/SourceEvent"
    },
    {
      "$ref": "#/$defs/SourceCoverage"
    },
    {
      "$ref": "#/$defs/ReviewBundle"
    },
    {
      "$ref": "#/$defs/ReviewResult"
    },
    {
      "$ref": "#/$defs/FactRevision"
    },
    {
      "$ref": "#/$defs/JournalPatch"
    },
    {
      "$ref": "#/$defs/FactArtifact"
    },
    {
      "$ref": "#/$defs/PublishResult"
    },
    {
      "$ref": "#/$defs/BookkeepingConfig"
    },
    {
      "$ref": "#/$defs/Manifest"
    }
  ],
  "$defs": {
    "Versioned": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        }
      },
      "required": [
        "schema_version"
      ]
    },
    "UnknownValue": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "value",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "TimeRange": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "from",
        "to"
      ]
    },
    "EventRef": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "type": "string"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "event_id"
      ]
    },
    "FactRef": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "fact_id": {
          "type": "string"
        },
        "revision": {
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "fact_id",
        "revision"
      ]
    },
    "SourceIdentity": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "provider": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "provider",
        "account_id",
        "conversation_id",
        "message_id",
        "block_id"
      ]
