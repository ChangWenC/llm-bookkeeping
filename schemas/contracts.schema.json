        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceCoverage"
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceCheckpoint"
          }
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "events",
        "fragments",
        "coverage",
        "checkpoints"
      ]
    },
    "PageBaseline": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "path",
        "digest",
        "content"
      ]
    },
    "ReviewChunk": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "chunk_id": {
          "type": "string"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvent"
          }
        },
        "context_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceEvent"
          }
        },
        "body_bytes": {
          "type": "number"
        }
      },
      "required": [
        "schema_version",
        "chunk_id",
        "events",
        "context_events",
        "body_bytes"
      ]
    },
    "ReviewBundle": {
      "type": "object",
