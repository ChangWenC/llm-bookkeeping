          "type": "array",
          "items": {
            "$ref": "#/$defs/PageBaseline"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceCoverage"
          }
        },
        "unfinished": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageGap"
          }
        }
      },
      "required": [
        "schema_version",
        "bundle_id",
        "kind",
        "lane",
        "period",
        "cutoff",
        "chunks",
        "existing_facts",
        "baselines",
        "coverage",
        "unfinished"
