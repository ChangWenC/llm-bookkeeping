        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CoverageGap"
          }
        },
        "capture_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "disabled",
            "unknown"
          ]
        },
        "review_status": {
          "enum": [
            "complete",
            "partial",
            "pending",
            "not_applicable"
          ]
        }
      },
      "required": [
        "schema_version",
        "coverage_id",
        "provider",
        "account_id",
        "conversation_id",
        "lane",
        "query_range",
        "cutoff",
        "read_ranges",
        "gaps",
        "capture_status",
        "review_status"
      ]
    },
    "SourceCheckpoint": {
      "type": "object",
      "properties": {
        "schema_version": {
