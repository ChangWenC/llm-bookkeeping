                }
              }
            }
          ]
        },
        "time_precision": {
          "enum": [
            "second",
            "millisecond",
            "microsecond",
            "day",
            "unknown"
          ]
        },
        "utc_time": {
          "allOf": [
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "wire_timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "journal_timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "journal_timezone_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "journal_date": {
          "allOf": [
            {
              "$ref": "#/$defs/UnknownValue"
            },
            {
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "classification": {
          "enum": [
            "main",
            "subagent",
            "automation",
            "unknown"
          ]
        },
        "context": {
          "type": "object"
        },
        "locator": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "source",
        "role",
        "kind",
        "channel",
        "body",
        "fragment_ref",
        "physical_order",
        "original_time",
        "time_precision",
        "utc_time",
        "wire_timezone",
        "journal_timezone",
        "journal_timezone_basis",
        "journal_date",
        "classification",
        "context",
        "locator",
        "generation"
      ]
    },
    "CoverageGap": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumable": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "range",
        "reason",
        "locator",
        "resumable"
      ]
    },
    "SourceCoverage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "coverage_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "account_id": {
          "type": "string"
        },
        "conversation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lane": {
          "enum": [
            "live",
            "history"
          ]
        },
        "query_range": {
          "$ref": "#/$defs/TimeRange"
